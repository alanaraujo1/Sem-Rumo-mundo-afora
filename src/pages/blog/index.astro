---
import PostCard from '../../components/PostCard.astro';
import { SITE_NAME } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<BaseLayout
  title={`Artigos de viagem | ${SITE_NAME}`}
  description="Todos os artigos do blog: roteiros, dicas práticas e relatos para planejar a sua próxima viagem."
>
  <h1 class="text-4xl font-bold tracking-tight">Artigos de viagem</h1>
  {
    posts.length > 0 ? (
      <div class="mt-10 grid gap-10 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    ) : (
      <p class="mt-10 text-stone-600">Os primeiros artigos estão a caminho.</p>
    )
  }
</BaseLayout>
