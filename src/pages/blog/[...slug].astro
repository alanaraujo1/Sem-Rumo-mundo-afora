---
import type { GetStaticPaths } from 'astro';
import { type CollectionEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPosts } from '../../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, cover, coverAlt, pubDate, updatedDate, author, tags, destination } = post.data;
const { Content } = await render(post);
---

<BaseLayout title={title} description={description} image={cover} imageAlt={coverAlt} article={post.data}>
  <article class="mx-auto max-w-3xl">
    <nav aria-label="Trilha de navegação" class="text-sm text-stone-600">
      <a href="/" class="hover:text-teal-700">Início</a> /
      <a href="/blog/" class="hover:text-teal-700">Blog</a> /
      <span aria-current="page">{title}</span>
    </nav>
    <header class="mt-6">
      <h1 class="text-4xl font-bold tracking-tight text-balance sm:text-5xl">{title}</h1>
      <p class="mt-4 text-stone-600">
        Por {author} · {destination.name} ·
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {
          updatedDate && (
            <>
              · Atualizado em <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
            </>
          )
        }
      </p>
    </header>
    <Image
      src={cover}
      alt={coverAlt}
      width={1200}
      height={675}
      widths={[480, 768, 1200]}
      sizes="(min-width: 800px) 768px, 100vw"
      priority
      class="mt-8 aspect-video w-full rounded-lg object-cover"
    />
    <div class="prose prose-stone prose-a:text-teal-700 mt-8 max-w-none">
      <Content />
    </div>
    <ul class="mt-10 flex flex-wrap gap-2" aria-label="Tags">
      {tags.map((tag) => <li class="rounded-full bg-stone-200 px-3 py-1 text-sm text-stone-800">{tag}</li>)}
    </ul>
  </article>
</BaseLayout>
