---
import type { GetStaticPaths } from 'astro';
import { type CollectionEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import TableOfContents from '../../components/TableOfContents.astro';
import { AUTHOR_NAME } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPosts, getReadingStats } from '../../lib/posts';
import '../../styles/article.css';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, category, cover, coverAlt, coverCredit, pubDate, updatedDate, author, tags } = post.data;
const { Content, headings } = await render(post);
const stats = getReadingStats(post.body);
const columnClass = 'mx-auto max-w-[752px] px-4';
---

<BaseLayout
  title={title}
  description={description}
  image={cover}
  imageAlt={coverAlt}
  article={{ ...post.data, ...stats }}
  fullWidth
>
  <article class="pb-16">
    <header>
      <figure class="mx-auto max-w-[1920px]">
        <Image
          src={cover}
          alt={coverAlt}
          width={1920}
          widths={[640, 960, 1280, 1600, 1920]}
          sizes="(min-width: 1920px) 1920px, 100vw"
          priority
          class="h-auto max-h-[75vh] w-full object-cover object-[50%_30%] lg:max-h-[560px]"
        />
        {
          coverCredit && (
            <figcaption class="mx-auto mt-2 max-w-[752px] px-4 text-sm text-stone-600">
              Foto: <a href={coverCredit.sourceUrl} rel="noopener" class="underline">{coverCredit.author}</a>,{' '}
              <a href={coverCredit.licenseUrl} rel="license noopener" class="underline">{coverCredit.license}</a>
              {coverCredit.changes && ` (${coverCredit.changes})`}.
            </figcaption>
          )
        }
      </figure>

      <div class:list={[columnClass, 'pt-8']}>
        <nav aria-label="Trilha de navegação" class="text-sm text-stone-600">
          <a href="/" class="hover:text-teal-700">Início</a> / <a href="/blog/" class="hover:text-teal-700">Blog</a> / <span aria-current="page">{title}</span>
        </nav>
        <p class="mt-6">
          <span class="inline-block rounded-full bg-teal-100 px-3 py-1 text-xs font-bold tracking-wide text-teal-900 uppercase">{category}</span>
        </p>
        <h1 class="mt-4 text-4xl leading-[1.1] font-extrabold tracking-tight text-balance sm:text-5xl">{title}</h1>
        <div class="mt-6 flex items-center gap-3">
          <span aria-hidden="true" class="flex size-11 shrink-0 items-center justify-center rounded-full bg-teal-800 text-lg font-bold text-white">{author.charAt(0)}</span>
          <div class="text-sm leading-relaxed text-stone-600">
            <p class="font-semibold text-stone-900">
              {author === AUTHOR_NAME ? <a href="/sobre/" rel="author" class="hover:text-teal-700 hover:underline">{author}</a> : author}
            </p>
            <p>
              <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
              {updatedDate && <span> · Atualizado em <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></span>}
              {` · ${stats.readingMinutes} min de leitura`}
            </p>
          </div>
        </div>
      </div>
    </header>

    <div class:list={[columnClass, 'mt-8']}>
      <TableOfContents headings={headings} />
      <div class="article-body prose prose-lg prose-stone prose-a:text-teal-700 prose-code:before:content-none prose-code:after:content-none mt-10 max-w-none">
        <Content />
      </div>
      <ul class="mt-10 flex flex-wrap gap-2" aria-label="Tags">
        {tags.map((tag) => <li class="rounded-full bg-stone-200 px-3 py-1 text-sm text-stone-800">{tag}</li>)}
      </ul>
    </div>
  </article>
</BaseLayout>
