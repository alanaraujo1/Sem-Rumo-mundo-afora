---
import type { GetStaticPaths } from 'astro';
import { type CollectionEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import AuthorAvatar from '../../components/AuthorAvatar.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { AUTHOR_NAME, tagLabel } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPosts, getReadingStats } from '../../lib/posts';
import '../../styles/article.css';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, seoTitle, description, cover, coverAlt, coverPosition, coverCredit, pubDate, updatedDate, author, tags, destination } = post.data;
const { Content, headings } = await render(post);
const stats = getReadingStats(post.body);
const columnClass = 'mx-auto max-w-[752px] px-4';
---

<BaseLayout
  title={seoTitle ?? title}
  description={description}
  image={cover}
  imageAlt={coverAlt}
  article={{ ...post.data, ...stats }}
  socialImageBase={`/og/${post.id}/`}
  fullWidth
>
  <article class="pb-16">
    <header>
      <div class:list={[columnClass, 'pt-8 sm:pt-12']}>
        <nav aria-label="Trilha de navegação" class="text-sm text-stone-600">
          <a href="/" class="hover:text-teal-700">Início</a>
          <span aria-hidden="true" class="mx-1.5 text-stone-400">/</span>
          <a href="/blog/" class="hover:text-teal-700">Artigos</a>
        </nav>
        <p class="mt-6 text-xs font-semibold tracking-[0.16em] text-teal-800 uppercase sm:text-[0.8125rem]">
          {destination.name} · {destination.region}
        </p>
        <h1 class="font-heading mt-3 text-[2.125rem] leading-[1.12] font-semibold tracking-tight text-balance text-stone-950 sm:text-5xl sm:leading-[1.08]">
          {title}
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-pretty text-stone-600 sm:text-xl">{description}</p>
        <div class="mt-6 flex items-center gap-3 border-t border-stone-200 pt-5">
          <AuthorAvatar size={44} author={author} />
          <div class="text-sm leading-relaxed text-stone-600">
            <p class="font-semibold text-stone-900">
              {author === AUTHOR_NAME ? <a href="/sobre/" rel="author" class="hover:text-teal-700 hover:underline">{author}</a> : author}
            </p>
            <p>
              <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
              {updatedDate && <span> · Atualizado em <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></span>}
              {` · ${stats.readingMinutes} min de leitura`}
            </p>
          </div>
        </div>
      </div>

      <figure class="mx-auto mt-8 max-w-6xl sm:mt-10 sm:px-4">
        <Image
          src={cover}
          alt={coverAlt}
          width={1920}
          widths={[480, 768, 1024, 1280, 1600, 1920]}
          quality={72}
          sizes="(min-width: 1152px) 1120px, (min-width: 640px) calc(100vw - 2rem), 100vw"
          priority
          class="aspect-[4/3] h-auto w-full object-cover sm:aspect-[16/9] sm:rounded-xl lg:aspect-[2/1]"
          style={{ objectPosition: coverPosition }}
        />
        {
          coverCredit && (
            <figcaption class="mt-2 px-4 text-right text-xs tracking-wide text-stone-500 sm:px-0">
              Foto: {coverCredit.sourceUrl ? <a href={coverCredit.sourceUrl} rel="noopener" class="underline">{coverCredit.author}</a> : coverCredit.author}
              {coverCredit.license && (
                <>
                  {', '}
                  <a href={coverCredit.licenseUrl} rel="license noopener" class="underline">{coverCredit.license}</a>
                </>
              )}
              {coverCredit.changes && ` (${coverCredit.changes})`}
            </figcaption>
          )
        }
      </figure>
    </header>

    <div class:list={[columnClass, 'mt-10']}>
      <TableOfContents headings={headings} />
      <div class="article-body prose prose-lg prose-stone prose-a:text-teal-700 prose-code:before:content-none prose-code:after:content-none prose-p:leading-[1.7] mt-10 max-w-none">
        <Content />
      </div>
      <div class="mt-12 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-t border-stone-200 pt-5 text-sm">
        <p class="text-xs font-semibold tracking-[0.14em] text-stone-500 uppercase">Temas</p>
        <ul class="flex flex-wrap text-stone-700" aria-label="Temas do artigo">
          {tags.map((tag, index) => <li>{index > 0 && <span aria-hidden="true" class="mx-2 text-stone-300">·</span>}{tagLabel(tag)}</li>)}
        </ul>
      </div>
      {author === AUTHOR_NAME && <AuthorBox />}
    </div>
  </article>
</BaseLayout>
