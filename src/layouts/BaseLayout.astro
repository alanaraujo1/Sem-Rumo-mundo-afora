---
import { Font } from 'astro:assets';
import ConsentMode from '../components/ConsentMode.astro';
import CookieConsent from '../components/CookieConsent.astro';
import InstagramLink from '../components/InstagramLink.astro';
import SEO, { type Props as SEOProps } from '../components/SEO.astro';
import { AUTHOR_NAME, INSTAGRAM, SITE_DESCRIPTION, SITE_LOCALE, SITE_NAME } from '../consts';
import '../styles/global.css';

type Props = SEOProps & {
  /** Remove o contêiner central para páginas com seções de largura total. */
  fullWidth?: boolean;
};

const { fullWidth = false, ...seo } = Astro.props;

const navItems = [
  { href: '/blog/', label: 'Artigos' },
  { href: '/sobre/', label: 'Sobre' },
  { href: '/contato/', label: 'Contato' },
];
const isCurrent = (href: string) => Astro.url.pathname.startsWith(href);
---

<!doctype html>
<html lang={SITE_LOCALE}>
  <head>
    <SEO {...seo} />
    <Font cssVariable="--font-display" preload />
    <ConsentMode />
  </head>
  <body class="flex min-h-dvh flex-col bg-stone-50 text-stone-900 antialiased">
    <header class="border-b border-stone-200">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-4">
        <a href="/" class="font-heading text-[1.0625rem] font-semibold tracking-tight whitespace-nowrap text-teal-900 sm:text-xl">{SITE_NAME}</a>
        <nav aria-label="Principal" class="flex gap-3 text-sm sm:gap-5 sm:text-base">
          {
            navItems.map(({ href, label }) => (
              <a
                href={href}
                aria-current={isCurrent(href) ? 'page' : undefined}
                class="border-b-2 border-transparent py-0.5 text-stone-700 hover:text-teal-700 aria-[current=page]:border-teal-700 aria-[current=page]:text-stone-900"
              >
                {label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main class:list={['w-full flex-1', !fullWidth && 'mx-auto max-w-5xl px-4 py-10']}>
      <slot />
    </main>
    <footer class="bg-stone-900 text-stone-300">
      <div class="mx-auto grid max-w-5xl gap-8 px-4 pt-12 pb-8 sm:grid-cols-[1.4fr_1fr]">
        <div>
          <a href="/" class="font-heading text-2xl font-semibold tracking-tight text-white">{SITE_NAME}</a>
          <p class="mt-3 max-w-sm text-sm leading-relaxed text-stone-400">{SITE_DESCRIPTION}</p>
        </div>
        <nav aria-label="Redes sociais">
          <p class="text-xs font-semibold tracking-[0.14em] text-stone-400 uppercase">Siga no Instagram</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li>
              <InstagramLink url={INSTAGRAM.blog.url} class="hover:text-white">
                Blog: <strong class="font-semibold text-white">{INSTAGRAM.blog.handle}</strong>
              </InstagramLink>
            </li>
            <li>
              <InstagramLink url={INSTAGRAM.author.url} class="hover:text-white">
                {AUTHOR_NAME}: <strong class="font-semibold text-white">{INSTAGRAM.author.handle}</strong>
              </InstagramLink>
            </li>
          </ul>
        </nav>
      </div>
      <div class="border-t border-stone-800">
        <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-6 text-sm text-stone-400">
          <p>© {new Date().getFullYear()} {SITE_NAME}</p>
          <nav aria-label="Institucional" class="flex flex-wrap gap-x-4 gap-y-2">
            <a href="/sobre/" class="hover:text-white">Sobre</a>
            <a href="/contato/" class="hover:text-white">Contato</a>
            <a href="/politica-de-privacidade/" class="hover:text-white">Política de Privacidade</a>
            <button type="button" data-cookie-settings class="cursor-pointer hover:text-white">Preferências de cookies</button>
          </nav>
        </div>
      </div>
    </footer>
    <CookieConsent />
  </body>
</html>
