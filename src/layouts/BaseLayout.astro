---
import ConsentMode from '../components/ConsentMode.astro';
import CookieConsent from '../components/CookieConsent.astro';
import InstagramLink from '../components/InstagramLink.astro';
import SEO, { type Props as SEOProps } from '../components/SEO.astro';
import { AUTHOR_NAME, INSTAGRAM, SITE_LOCALE, SITE_NAME } from '../consts';
import '../styles/global.css';

type Props = SEOProps & {
  /** Remove o contêiner central para páginas com seções de largura total. */
  fullWidth?: boolean;
};

const { fullWidth = false, ...seo } = Astro.props;
---

<!doctype html>
<html lang={SITE_LOCALE}>
  <head>
    <SEO {...seo} />
    <ConsentMode />
  </head>
  <body class="flex min-h-dvh flex-col bg-stone-50 text-stone-900 antialiased">
    <header class="border-b border-stone-200">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4">
        <a href="/" class="text-lg font-bold tracking-tight text-teal-800">{SITE_NAME}</a>
        <nav aria-label="Principal" class="flex gap-4">
          <a href="/blog/" class="text-stone-700 hover:text-teal-700">Artigos</a>
          <a href="/sobre/" class="text-stone-700 hover:text-teal-700">Sobre</a>
          <a href="/contato/" class="text-stone-700 hover:text-teal-700">Contato</a>
        </nav>
      </div>
    </header>
    <main class:list={['w-full flex-1', !fullWidth && 'mx-auto max-w-5xl px-4 py-10']}>
      <slot />
    </main>
    <footer class="border-t border-stone-200">
      <nav aria-label="Redes sociais" class="mx-auto max-w-5xl px-4 pt-6">
        <p class="text-sm font-semibold text-stone-900">Siga no Instagram</p>
        <ul class="mt-3 flex flex-col gap-2 text-sm text-stone-700 sm:flex-row sm:gap-8">
          <li>
            <InstagramLink url={INSTAGRAM.blog.url} class="hover:text-teal-700">
              Instagram do Blog: <strong class="font-semibold">{INSTAGRAM.blog.handle}</strong>
            </InstagramLink>
          </li>
          <li>
            <InstagramLink url={INSTAGRAM.author.url} class="hover:text-teal-700">
              Instagram do Autor ({AUTHOR_NAME}): <strong class="font-semibold">{INSTAGRAM.author.handle}</strong>
            </InstagramLink>
          </li>
        </ul>
      </nav>
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-6 text-sm text-stone-600">
        <p>© {new Date().getFullYear()} {SITE_NAME}</p>
        <nav aria-label="Institucional" class="flex flex-wrap gap-x-4 gap-y-2">
          <a href="/sobre/" class="hover:text-teal-700">Sobre</a>
          <a href="/contato/" class="hover:text-teal-700">Contato</a>
          <a href="/politica-de-privacidade/" class="hover:text-teal-700">Política de Privacidade</a>
          <button type="button" data-cookie-settings class="cursor-pointer hover:text-teal-700">Preferências de cookies</button>
        </nav>
      </div>
    </footer>
    <CookieConsent />
  </body>
</html>
