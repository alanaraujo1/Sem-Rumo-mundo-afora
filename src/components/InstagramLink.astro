---
interface Props {
  url: string;
  class?: string;
}

const { url, class: className } = Astro.props;
---

<a href={url} target="_blank" rel="noopener noreferrer" class:list={['inline-flex items-center gap-1.5', className]}>
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="size-4 shrink-0"
  >
    <rect x="3" y="3" width="18" height="18" rx="5"></rect>
    <circle cx="12" cy="12" r="4"></circle>
    <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"></circle>
  </svg>
  <span><slot /></span>
  <span class="sr-only">(abre em nova aba)</span>
</a>
