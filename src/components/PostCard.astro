---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { formatDate } from '../lib/posts';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, cover, coverAlt, pubDate, destination } = post.data;
---

<article class="group">
  <a href={`/blog/${post.id}/`} class="block">
    <Image
      src={cover}
      alt={coverAlt}
      width={720}
      height={405}
      widths={[360, 720]}
      sizes="(min-width: 768px) 368px, 100vw"
      class="aspect-video w-full rounded-lg object-cover"
    />
    <p class="mt-4 text-sm text-stone-600">
      {destination.name} · <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    </p>
    <h2 class="mt-1 text-xl font-semibold text-balance group-hover:text-teal-700">{title}</h2>
    <p class="mt-2 text-stone-700">{description}</p>
  </a>
</article>
