---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { formatShortDate, getReadingStats } from '../lib/posts';

interface Props {
  post: CollectionEntry<'blog'>;
  /** Destaque da Home: foto maior ao lado do texto e carregada com prioridade (é o LCP). */
  featured?: boolean;
  headingLevel?: 'h2' | 'h3';
  /** Primeiro card visível da página: carrega sem lazy-load por ser o LCP. */
  eager?: boolean;
}

const { post, featured = false, headingLevel: Heading = 'h2', eager = false } = Astro.props;
const { title, seoTitle, description, cover, coverAlt, coverPosition, pubDate, destination } = post.data;
const { readingMinutes } = getReadingStats(post.body);
// O seoTitle já é a versão curta do título, sem repetir "na Chapada Diamantina".
const cardTitle = seoTitle ?? title;
---

<article class:list={['group relative', featured && 'grid items-center gap-6 lg:grid-cols-[1.45fr_1fr] lg:gap-10']}>
  <div class="overflow-hidden rounded-xl bg-stone-200">
    <Image
      src={cover}
      alt={coverAlt}
      width={featured ? 1280 : 720}
      height={featured ? 853 : 480}
      widths={featured ? [480, 720, 960, 1180] : [360, 540, 720]}
      sizes={featured ? '(min-width: 1024px) 590px, calc(100vw - 2rem)' : '(min-width: 1024px) 309px, (min-width: 768px) calc(50vw - 2rem), calc(100vw - 2rem)'}
      priority={featured || eager}
      quality={featured ? 62 : 64}
      class="aspect-[3/2] h-auto w-full object-cover transition-transform duration-500 ease-out motion-safe:group-hover:scale-[1.03]"
      style={{ objectPosition: coverPosition }}
    />
  </div>
  <div class:list={[!featured && 'mt-4']}>
    <p class="text-xs font-semibold tracking-[0.14em] text-teal-800 uppercase">{destination.name}</p>
    <Heading
      class:list={[
        'font-heading mt-2 font-semibold tracking-tight text-balance text-stone-950 group-hover:text-teal-800',
        featured ? 'text-[1.75rem] leading-tight sm:text-4xl' : 'text-[1.375rem] leading-snug',
      ]}
    >
      <a href={`/blog/${post.id}/`} class="after:absolute after:inset-0">{cardTitle}</a>
    </Heading>
    <p class:list={['mt-2 text-stone-700', featured ? 'text-lg leading-relaxed' : 'line-clamp-3']}>{description}</p>
    <p class="mt-3 text-sm text-stone-500">
      <time datetime={pubDate.toISOString()}>{formatShortDate(pubDate)}</time> · {readingMinutes} min de leitura
    </p>
  </div>
</article>
