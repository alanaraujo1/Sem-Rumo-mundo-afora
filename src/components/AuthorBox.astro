---
import { AUTHOR_BIO, AUTHOR_NAME, INSTAGRAM } from '../consts';
import AuthorAvatar from './AuthorAvatar.astro';
import InstagramLink from './InstagramLink.astro';

// Primeira frase da biografia, que apresenta o autor.
const shortBio = `${AUTHOR_BIO.split('. ')[0]}.`;
const linkClass = 'font-semibold text-teal-700 hover:underline';
---

<aside aria-labelledby="author-box-title" class="mt-12 rounded-xl border border-stone-200 bg-white p-6">
  <div class="flex flex-col gap-4 sm:flex-row sm:gap-5">
    <AuthorAvatar size={64} />
    <div class="text-stone-700">
      <p class="text-xs font-semibold tracking-[0.14em] text-stone-500 uppercase">Sobre o autor</p>
      <h2 id="author-box-title" class="font-heading mt-1 text-xl font-semibold text-stone-900">
        <a href="/sobre/" rel="author" class="hover:text-teal-700 hover:underline">{AUTHOR_NAME}</a>
      </h2>
      <p class="mt-2 leading-relaxed">{shortBio}</p>
      <ul class="mt-4 space-y-2 text-sm">
        <li>
          Acompanhe as viagens e fotografias em{' '}
          <InstagramLink url={INSTAGRAM.author.url} class={linkClass}>{INSTAGRAM.author.handle}</InstagramLink>
        </li>
        <li>
          Siga as novidades da comunidade em{' '}
          <InstagramLink url={INSTAGRAM.blog.url} class={linkClass}>{INSTAGRAM.blog.handle}</InstagramLink>
        </li>
      </ul>
    </div>
  </div>
</aside>
