---
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { AUTHOR_NAME, INSTAGRAM, SITE_DESCRIPTION, SITE_LOCALE, SITE_NAME } from '../consts';

export interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  noindex?: boolean;
  /** Nós extras de JSON-LD da página, como AboutPage ou ContactPage. */
  schema?: Record<string, unknown>[];
  /** Presente apenas em artigos: ativa og:type=article e o JSON-LD de BlogPosting. */
  article?: Pick<
    CollectionEntry<'blog'>['data'],
    'title' | 'category' | 'pubDate' | 'updatedDate' | 'author' | 'tags' | 'destination'
  > & { wordCount: number; readingMinutes: number };
}

const { title, description = SITE_DESCRIPTION, image, imageAlt, noindex = false, schema = [], article } = Astro.props;

const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const absolute = (path: string) => new URL(path, site).href;
const resized = async (src: ImageMetadata, width: number, height: number) =>
  absolute((await getImage({ src, width, height, format: 'jpeg' })).src);

const ogImage = image && (await resized(image, 1200, 630));

const websiteId = `${site.href}#website`;
const organizationId = `${site.href}#organization`;
const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: site.href,
    name: SITE_NAME,
    description: SITE_DESCRIPTION,
    inLanguage: SITE_LOCALE,
    publisher: { '@id': organizationId },
  },
  {
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE_NAME,
    url: site.href,
    sameAs: [INSTAGRAM.blog.url],
  },
];

if (article) {
  const { name, region, countryCode, coordinates } = article.destination;
  graph.push(
    {
      '@type': 'BlogPosting',
      '@id': `${canonical}#article`,
      mainEntityOfPage: canonical,
      isPartOf: { '@id': websiteId },
      headline: article.title,
      description,
      // O Google recomenda as proporções 16:9, 4:3 e 1:1 para artigos.
      image: image && [
        await resized(image, 1200, 675),
        await resized(image, 1200, 900),
        await resized(image, 1200, 1200),
      ],
      datePublished: article.pubDate.toISOString(),
      dateModified: (article.updatedDate ?? article.pubDate).toISOString(),
      author: {
        '@type': 'Person',
        name: article.author,
        ...(article.author === AUTHOR_NAME && { url: absolute('/sobre/'), sameAs: [INSTAGRAM.author.url] }),
      },
      publisher: { '@id': organizationId },
      inLanguage: SITE_LOCALE,
      articleSection: article.category,
      keywords: article.tags.join(', '),
      wordCount: article.wordCount,
      timeRequired: `PT${article.readingMinutes}M`,
      contentLocation: {
        '@type': 'Place',
        name,
        address: {
          '@type': 'PostalAddress',
          addressCountry: countryCode,
          ...(region && { addressRegion: region }),
        },
        ...(coordinates && { geo: { '@type': 'GeoCoordinates', ...coordinates } }),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Início', item: site.href },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: absolute('/blog/') },
        { '@type': 'ListItem', position: 3, name: article.title, item: canonical },
      ],
    },
  );
}

graph.push(...schema);

// Escapa "<" para que nenhum texto do artigo consiga fechar a tag <script>.
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />

<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content={SITE_LOCALE.replace('-', '_')} />
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{
  ogImage && (
    <>
      <meta property="og:image" content={ogImage} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    </>
  )
}
{
  article && (
    <>
      <meta property="article:published_time" content={article.pubDate.toISOString()} />
      {article.updatedDate && <meta property="article:modified_time" content={article.updatedDate.toISOString()} />}
      <meta property="article:author" content={article.author} />
      {article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    </>
  )
}

<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

<script is:inline type="application/ld+json" set:html={jsonLd} />
