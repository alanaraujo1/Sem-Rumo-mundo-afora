---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

type Section = MarkdownHeading & { children: MarkdownHeading[] };

const sections: Section[] = [];
for (const heading of Astro.props.headings) {
  const parent = sections.at(-1);
  if (heading.depth === 2 || !parent) {
    if (heading.depth <= 3) sections.push({ ...heading, children: [] });
  } else if (heading.depth === 3) {
    parent.children.push(heading);
  }
}
const linkClass = 'block py-1 text-stone-700 hover:text-teal-800 hover:underline';
---

{
  sections.length > 0 && (
    <nav aria-labelledby="toc-title" class="border-y border-stone-200 py-5">
      <details open>
        <summary id="toc-title" class="cursor-pointer text-xs font-semibold tracking-[0.14em] text-stone-500 uppercase">
          Neste artigo
        </summary>
        <ol class="toc-list mt-3 text-[0.95rem] leading-snug">
          {sections.map((section) => (
            <li>
              <a href={`#${section.slug}`} class={linkClass}>{section.text}</a>
              {section.children.length > 0 && (
                <ol class="mb-1 border-l border-stone-200 pl-4 text-[0.9rem]">
                  {section.children.map((child) => (
                    <li>
                      <a href={`#${child.slug}`} class={linkClass}>{child.text}</a>
                    </li>
                  ))}
                </ol>
              )}
            </li>
          ))}
        </ol>
      </details>
    </nav>
  )
}
