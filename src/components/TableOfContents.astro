---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

type Section = MarkdownHeading & { children: MarkdownHeading[] };

const sections: Section[] = [];
for (const heading of Astro.props.headings) {
  const parent = sections.at(-1);
  if (heading.depth === 2 || !parent) {
    if (heading.depth <= 3) sections.push({ ...heading, children: [] });
  } else if (heading.depth === 3) {
    parent.children.push(heading);
  }
}
const linkClass = 'block py-1 text-stone-700 hover:text-teal-700 hover:underline';
---

{
  sections.length > 0 && (
    <nav aria-labelledby="toc-title" class="rounded-lg border border-stone-200 bg-white px-5 py-4">
      <details open>
        <summary id="toc-title" class="cursor-pointer font-semibold text-stone-900">
          Neste artigo
        </summary>
        <ol class="mt-3 text-[0.95rem] leading-snug">
          {sections.map((section) => (
            <li>
              <a href={`#${section.slug}`} class={linkClass}>{section.text}</a>
              {section.children.length > 0 && (
                <ol class="mb-1 border-l border-stone-200 pl-4">
                  {section.children.map((child) => (
                    <li>
                      <a href={`#${child.slug}`} class={linkClass}>{child.text}</a>
                    </li>
                  ))}
                </ol>
              )}
            </li>
          ))}
        </ol>
      </details>
    </nav>
  )
}
