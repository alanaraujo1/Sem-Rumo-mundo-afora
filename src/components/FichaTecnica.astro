---
interface Props {
  items: { label: string; value: string }[];
}

const { items } = Astro.props;
// Número e unidade na mesma linha ("300 m", "40 km", "10 °C").
const keepUnit = (text: string) => text.replace(/(\d) (?=(?:km|m|h|min|minutos|horas|noites|dias|°C)\b|°C)/g, '$1\u00a0');
---

<section aria-labelledby="ficha-tecnica" class="rounded-xl border border-stone-200 bg-white px-5 py-5">
  <h2 id="ficha-tecnica" class="sr-only">Ficha técnica</h2>
  <dl class="grid grid-cols-2 gap-x-6 gap-y-5 lg:grid-cols-4">
    {
      items.map(({ label, value }) => (
        <div class="min-w-0">
          <dt class="text-xs font-semibold tracking-[0.14em] text-teal-800 uppercase">{label}</dt>
          <dd class="mt-1.5 text-[0.95rem] leading-snug text-pretty break-words text-stone-800">{keepUnit(value)}</dd>
        </div>
      ))
    }
  </dl>
</section>
